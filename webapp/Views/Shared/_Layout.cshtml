<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Athora Italia Data Catalog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-database-gear"></i> Athora Data Catalog
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-collection"></i> Catalogo
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Index">Sistemi Sorgente</a></li>
                            <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Assets">Data Asset</a></li>
                            <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Search">Ricerca Entit&agrave;</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Regulatory">Report Regolamentari</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-diagram-3"></i> Lineage
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Lineage" asp-action="Pipelines">Pipeline ETL</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-shield-check"></i> Governance
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Governance" asp-action="Index">Workflow Approvativi</a></li>
                            <li><a class="dropdown-item" asp-controller="Governance" asp-action="Gdpr">Registro GDPR</a></li>
                            <li><a class="dropdown-item" asp-controller="Governance" asp-action="Criticality">Matrice Criticit&agrave;</a></li>
                        </ul>
                    </li>
                </ul>
                <form class="d-flex ms-auto" asp-controller="Catalog" asp-action="Search" method="get">
                    <input class="form-control me-2" type="search" name="SearchTerm" placeholder="Cerca nel catalogo..." />
                    <button class="btn btn-outline-light" type="submit"><i class="bi bi-search"></i></button>
                </form>
            </div>
        </div>
    </nav>

    <main class="container-fluid mt-3">
        @RenderBody()
    </main>

    <footer class="container-fluid mt-5 py-3 border-top text-muted text-center">
        <small>Athora Italia - Governed Data Catalog &copy; @DateTime.Now.Year | Data Warehouse Team</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
