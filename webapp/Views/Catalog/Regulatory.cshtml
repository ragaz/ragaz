@model IEnumerable<RegulatoryReportModel>
@{ ViewData["Title"] = "Report Regolamentari"; }

<h2><i class="bi bi-bank"></i> Report Regolamentari</h2>
<p class="text-muted">Obblighi di segnalazione verso Autorit&agrave; di Vigilanza</p>

<div class="row g-3">
@foreach (var r in Model)
{
    var critColor = r.CriticalityLevel switch {
        "CRITICAL" => "border-danger",
        "HIGH" => "border-warning",
        _ => ""
    };
    var bodyIcon = r.RegulatoryBody switch {
        "IVASS" => "bi-shield-fill",
        "BANCA_ITALIA" => "bi-bank",
        "EIOPA" => "bi-globe-europe-africa",
        _ => "bi-file-text"
    };
    <div class="col-md-4">
        <div class="card h-100 @critColor">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi @bodyIcon"></i> @r.ReportCode</span>
                <span class="badge @(r.CriticalityLevel == "CRITICAL" ? "bg-danger" : "bg-warning text-dark")">@r.CriticalityLevel</span>
            </div>
            <div class="card-body">
                <h6>@r.ReportName</h6>
                <table class="table table-sm table-borderless">
                    <tr><td class="text-muted">Autorit&agrave;</td><td>@r.RegulatoryBody</td></tr>
                    <tr><td class="text-muted">Normativa</td><td>@r.Regulation</td></tr>
                    <tr><td class="text-muted">Frequenza</td><td>@r.Frequency</td></tr>
                    <tr><td class="text-muted">Scadenza</td><td>@r.Deadline</td></tr>
                    <tr><td class="text-muted">Team</td><td>@r.ResponsibleTeam</td></tr>
                    <tr><td class="text-muted">Entit&agrave; sorgente</td><td><span class="badge bg-info">@r.SourceEntityCount</span></td></tr>
                </table>
            </div>
        </div>
    </div>
}
</div>
