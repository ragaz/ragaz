@model DashboardModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-speedometer2"></i> Dashboard Governance Dati</h2>
        <p class="text-muted">Panoramica del patrimonio dati di Athora Italia</p>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card text-center border-primary">
            <div class="card-body">
                <h3 class="text-primary">@Model.TotalSystems</h3>
                <small class="text-muted">Sistemi Sorgente</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-info">
            <div class="card-body">
                <h3 class="text-info">@Model.TotalAssets</h3>
                <small class="text-muted">Data Asset</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-success">
            <div class="card-body">
                <h3 class="text-success">@Model.TotalEntities</h3>
                <small class="text-muted">Entit&agrave; Dati</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-secondary">
            <div class="card-body">
                <h3>@Model.TotalAttributes</h3>
                <small class="text-muted">Attributi</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-dark">
            <div class="card-body">
                <h3>@Model.TotalPipelines</h3>
                <small class="text-muted">Pipeline ETL</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card text-center border-warning">
            <div class="card-body">
                <h3 class="text-warning">@Model.PendingWorkflows</h3>
                <small class="text-muted">Workflow Pendenti</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Classificazione -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-shield-lock"></i> Classificazione Dati (DLP)</div>
            <div class="card-body">
                @foreach (var cl in Model.ByClassification)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>
                            <span class="badge" style="background-color: @cl.Color">@cl.LevelName</span>
                        </span>
                        <strong>@cl.EntityCount</strong>
                    </div>
                    <div class="progress mb-3" style="height: 6px;">
                        @{
                            var pct = Model.TotalEntities > 0 ? (cl.EntityCount * 100 / Model.TotalEntities) : 0;
                        }
                        <div class="progress-bar" style="width: @(pct)%; background-color: @cl.Color"></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- GDPR -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person-lock"></i> Compliance GDPR</div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-4">
                        <h4 class="text-danger">@Model.WithPersonalData</h4>
                        <small>Con dati personali</small>
                    </div>
                    <div class="col-4">
                        <h4 class="text-danger">@Model.WithSensitiveData</h4>
                        <small>Con dati sensibili</small>
                    </div>
                    <div class="col-4">
                        <h4 class="text-warning">@Model.GdprRelevant</h4>
                        <small>GDPR rilevanti</small>
                    </div>
                </div>
                <hr />
                <a asp-controller="Governance" asp-action="Gdpr" class="btn btn-outline-danger btn-sm w-100">
                    <i class="bi bi-journal-text"></i> Registro Trattamenti Art. 30
                </a>
            </div>
        </div>
    </div>

    <!-- Criticità -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-exclamation-triangle"></i> Criticit&agrave; Entit&agrave;</div>
            <div class="card-body">
                @{
                    var critColors = new Dictionary<string, string> {
                        {"CRITICAL", "#DC3545"}, {"HIGH", "#FFC107"}, {"MEDIUM", "#17A2B8"}, {"LOW", "#28A745"}
                    };
                }
                @foreach (var kv in Model.ByCriticality.OrderBy(x => x.Key == "CRITICAL" ? 0 : x.Key == "HIGH" ? 1 : x.Key == "MEDIUM" ? 2 : 3))
                {
                    var color = critColors.GetValueOrDefault(kv.Key, "#6C757D");
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge" style="background-color: @color">@kv.Key</span>
                        <strong>@kv.Value</strong>
                    </div>
                }
                <hr />
                <a asp-controller="Governance" asp-action="Criticality" class="btn btn-outline-danger btn-sm w-100">
                    <i class="bi bi-grid-3x3"></i> Matrice Criticit&agrave; Completa
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Stato Governance -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-check2-circle"></i> Stato Governance</div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead><tr><th>Stato</th><th class="text-end">Entit&agrave;</th></tr></thead>
                    <tbody>
                    @foreach (var kv in Model.ByGovernanceStatus)
                    {
                        var badgeClass = kv.Key switch {
                            "APPROVED" => "bg-success",
                            "IN_REVIEW" => "bg-warning",
                            "DRAFT" => "bg-secondary",
                            "DEPRECATED" => "bg-dark",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td><span class="badge @badgeClass">@kv.Key</span></td>
                            <td class="text-end">@kv.Value</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><i class="bi bi-bank"></i> Report Regolamentari</div>
            <div class="card-body">
                <a asp-controller="Catalog" asp-action="Regulatory" class="btn btn-outline-primary btn-sm mb-3">
                    Vedi tutti i report regolamentari
                </a>
                <p class="text-muted small">
                    Modelli IVASS (34, 35, 39, 40, 41), Segnalazioni Banca d'Italia (residenti esteri),
                    Antiriciclaggio, QRT Solvency II
                </p>
            </div>
        </div>
    </div>
</div>
